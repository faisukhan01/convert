# ──────────────────────────────────────────────────────────────────────────────
# RidgeLine Convert — configuration template
# Copy to .env, fill what you have, and start. Everything below can begin EMPTY:
# the local demo runs with zero credentials and every integration reports its
# real state ("configured" / "not_configured") on GET /api/health.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core app ──────────────────────────────────────────────────────────────────

# Public base URL used in customer-facing links (booking links, webhooks).
APP_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL / Neon — the primary and authoritative store) ────────
# Local dev: the dev launcher starts an embedded PostgreSQL on :5432 automatically;
# the default below just works.
# Production: create a project at https://neon.tech and paste the POOLED connection
# string. Sync the schema once with:  DATABASE_URL="<neon url>" bun run db:push
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
# For schema migrations against Neon, prefer the UNPOOLED (direct) string.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# Signs staff session cookies (HMAC). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development, a deterministic dev secret is used (never in production).
SESSION_SECRET=

# Encrypts provider OAuth tokens at rest (AES-256-GCM). Same generation command.
# If unset in development, a deterministic dev key is used (never in production).
TOKEN_ENCRYPTION_KEY=

# ── Staff sign-in (OIDC — Google Workspace, Entra, Auth0, any OIDC provider) ──
# Local demo sign-in uses seeded roles (password "demo"). Provide these to move
# staff login to your identity provider (e.g. Google OAuth2 endpoints).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── AI provider (server-side only — never exposed to the browser) ─────────────
# "zai" is the default and requires no key in this deployment environment.
# Switch to OpenAI by setting AI_PROVIDER=openai + OPENAI_API_KEY.
# Optional model override (defaults: zai → glm-4-flash, openai → gpt-4o-mini).
AI_PROVIDER=zai
AI_MODEL=
OPENAI_API_KEY=

# ── Lead ingestion API (POST /api/v1/leads) ───────────────────────────────────
# Per-organization API keys are minted at runtime (owner/office role):
#   POST /api/api-keys {name}            — or —
#   bun scripts/mint-api-key.ts --slug summit --name "Company website"
# Keys are stored SHA-256-hashed; the raw key is shown exactly once. Nothing to
# configure here — this block is documentation.

# ── Background worker (mini-services/worker) ──────────────────────────────────
# Independent TypeScript job processor (AI classification, retries, dead-letter).
# Needs the same DATABASE_URL. Health: GET :3004/health
WORKER_PORT=3004

# ── Optional connectors (the product never depends on these) ──────────────────

# GoHighLevel (marketplace app) — retained as an OPTIONAL connector.
# Unlocks: OAuth install per location, calendar sync, SMS/email sending,
# estimate status sync via webhooks.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/connections/ghl/callback
GHL_WEBHOOK_SECRET=

# Jobber (optional payment connector).
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=

# Gmail connector (official Google OAuth 2.0 + Gmail API). Subject to Google's
# restricted-scope verification before production launch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Lead Ads (official Meta Graph API + webhooks; requires Meta app review).
META_APP_ID=
META_APP_SECRET=

# WhatsApp Business Platform (official Cloud API; requires a verified business
# phone number and approved templates).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Notes ─────────────────────────────────────────────────────────────────────
# • Nothing above needs to be pasted into chat. Secrets go to env or a deploy
#   secret manager; token values are stored encrypted per organization.
# • Never expose API keys or database credentials through NEXT_PUBLIC_* variables.
# • Connection status tracking keeps "configured" and "verified live" visibly
#   distinct — an unconfigured connector is never simulated as connected.
